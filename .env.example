# Local development defaults. Copy to .env and adjust.
# .env is gitignored; never commit real secrets.

POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=kb
POSTGRES_PORT=5432

# CLI / core local mode (cli-surface.md §3.7)
KB_DATABASE_URL=postgresql://kb:kb@127.0.0.1:5432/kb

# Optional read-path services. When unset, CLI uses these defaults.
# Doctor reports them as degraded (not fail) if unreachable.
KB_TEI_URL=http://localhost:8080
KB_EMBED_MODEL=BAAI/bge-m3
KB_OLLAMA_URL=http://localhost:11434
